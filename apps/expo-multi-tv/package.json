{
  "name": "@multi-tv/expo-multi-tv",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "ios": "EXPO_TV=1 expo run:ios",
    "web": "expo start --web --port 8082",
    "dev:web": "expo start --web --port 8082",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "prebuild": "EXPO_TV=1 expo prebuild --clean",
    "clean": "rm -rf node_modules",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@multi-tv/shared-ui": "workspace:*",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lint-staged": "^15.2.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@~0.81.0-0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyevent": "^0.3.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-video": "^6.8.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-tv-space-navigation": "6.0.0-beta1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@react-native-tvos/config-tv": "^0.0.10",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.1.6",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-native-pixel-perfect": "^1.0.2",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.tsx": [
      "prettier --write"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
